DATABASE_URL=postgres://wr:wr@localhost:5432/wohnungsradar
API_PORT=4000
# Brave Search API key (https://brave.com/search/api/) – enables web discovery sources
BRAVE_API_KEY=
# Comma-separated source ids; empty = all
SOURCES_ENABLED=
# Cities to crawl (slugs from packages/geo/src/cities.ts)
CRAWL_CITIES=berlin
# Nominatim endpoint (respect usage policy: 1 req/s, identify yourself)
NOMINATIM_URL=https://nominatim.openstreetmap.org
CONTACT_EMAIL=

# Optional: Claude writes the suggested contact messages (falls back to a template without it)
ANTHROPIC_API_KEY=
